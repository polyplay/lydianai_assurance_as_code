[Unit]
Description=LydianAI Assurance-as-Code backend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/docker compose --env-file __INSTALL_DIR__/.env -f __INSTALL_DIR__/installer/backend/docker-compose.backend.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file __INSTALL_DIR__/.env -f __INSTALL_DIR__/installer/backend/docker-compose.backend.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

