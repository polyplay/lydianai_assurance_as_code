# LydianAI Assurance-as-Code backend production environment.
# Copy to the installation directory as .env and replace all CHANGE_ME values.

AAC_ENVIRONMENT=production

# Host ports.
AAC_API_PORT=18000
AAC_NGINX_PORT=18080
AAC_POSTGRES_PORT=15432
AAC_REDIS_PORT=16379

# Database.
AAC_POSTGRES_DB=aac
AAC_POSTGRES_USER=aac
AAC_POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
AAC_DATABASE_URL=postgresql+asyncpg://aac:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/aac

# Redis.
AAC_REDIS_URL=redis://redis:6379/0

# Application secrets.
AAC_JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
AAC_SECRET_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_SECRET_ENCRYPTION_KEY

# External services.
AAC_GITHUB_API_BASE_URL=https://api.github.com

